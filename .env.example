# Optional: the live domain, used for absolute URLs in page metadata.
# NEXT_PUBLIC_SITE_URL=https://nigat-construction.vercel.app

# Optional: sister-site URLs for the Nigat Group menu (defaults in src/constants/nigat-group.ts).
# NEXT_PUBLIC_CONSTRUCTION_URL=
# NEXT_PUBLIC_MOTORS_URL=
# NEXT_PUBLIC_EXPORTS_URL=

# Enquiry form delivery: configure at least one channel (see src/lib/forms.ts).
# Telegram group (create a bot with @BotFather, add it to the sales group):
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Email via Resend (https://resend.com):
# RESEND_API_KEY=
# ENQUIRY_TO_EMAIL=sales@example.com
# ENQUIRY_FROM_EMAIL=Website <website@your-domain>
# Any form service / webhook receiving JSON (the older name FORM_WEBHOOK_URL still works):
# ENQUIRY_WEBHOOK_URL=
