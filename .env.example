# Nigat CMS (Strapi) — the shared content backend for all three Nigat sites.
# Locally: http://localhost:1337 (run the CMS from ../nigat_portfolio_cms).
CMS_URL=http://localhost:1337

# Must equal REVALIDATE_SECRET in the CMS .env. The CMS calls /api/revalidate
# with it whenever content is published, so pages refresh within seconds.
REVALIDATE_SECRET=
